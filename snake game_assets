def load_goblin_frames(path, target_size):
    sheet = pygame.image.load(path).convert()
    sheet.set_colorkey((0, 0, 0))

    sheet_width, sheet_height = sheet.get_size()
    frame_w = sheet_width // GOBLIN_SHEET_COLS
    frame_h = sheet_height // GOBLIN_SHEET_ROWS

    rows = []
    for row in range(GOBLIN_SHEET_ROWS):
        frame_list = []
        for col in range(GOBLIN_SHEET_COLS):
            frame = pygame.Surface((frame_w, frame_h)).convert()
            frame.blit(
                sheet,
                (0, 0),
                pygame.Rect(col * frame_w, row * frame_h, frame_w, frame_h)
            )
            frame.set_colorkey((0, 0, 0))
            frame = pygame.transform.scale(frame, (target_size, target_size))
            frame_list.append(frame)
        rows.append(frame_list)

    frames = {
        DIR_DOWN: rows[0][:GOBLIN_WALK_FRAMES],
        DIR_LEFT: rows[3][:GOBLIN_WALK_FRAMES],
        DIR_UP: rows[2][:GOBLIN_WALK_FRAMES],
        DIR_RIGHT: rows[1][:GOBLIN_WALK_FRAMES],
    }
    return frames


