def spawn_goblin():
    side = random.choice(["top", "bottom", "left", "right"])

    if side == "top":
        start_x = random.randint(0, WIDTH - GOBLIN_SIZE)
        start_y = -GOBLIN_SIZE
        target_x = random.randint(0, WIDTH - GOBLIN_SIZE)
        target_y = random.randint(0, HEIGHT - GOBLIN_SIZE)
    elif side == "bottom":
        start_x = random.randint(0, WIDTH - GOBLIN_SIZE)
        start_y = HEIGHT + GOBLIN_SIZE
        target_x = random.randint(0, WIDTH - GOBLIN_SIZE)
        target_y = random.randint(0, HEIGHT - GOBLIN_SIZE)
    elif side == "left":
        start_x = -GOBLIN_SIZE
        start_y = random.randint(0, HEIGHT - GOBLIN_SIZE)
        target_x = random.randint(0, WIDTH - GOBLIN_SIZE)
        target_y = random.randint(0, HEIGHT - GOBLIN_SIZE)
    else:
        start_x = WIDTH + GOBLIN_SIZE
        start_y = random.randint(0, HEIGHT - GOBLIN_SIZE)
        target_x = random.randint(0, WIDTH - GOBLIN_SIZE)
        target_y = random.randint(0, HEIGHT - GOBLIN_SIZE)

    return {
        "state": "entering",
        "x": float(start_x),
        "y": float(start_y),
        "target_x": float(target_x),
        "target_y": float(target_y),
        "dir_name": DIR_DOWN,
        "anim_index": 0.0,
        "turn_time": 0.0,
        "active_until": 0.0,
        "cooldown_until": 0.0,
        "score_taken_lock": False,
        "axis_toggle": 0,
        "axis_switch_timer": 0.0,
    }


def move_toward_point(entity, dt):
    dx = entity["target_x"] - entity["x"]
    dy = entity["target_y"] - entity["y"]

    entity["axis_switch_timer"] += dt

    if abs(dx) <= GOBLIN_SPEED and abs(dy) <= GOBLIN_SPEED:
        entity["x"] = entity["target_x"]
        entity["y"] = entity["target_y"]
        entity["axis_switch_timer"] = 0.0
        return True

    prefer_x = entity["axis_toggle"] == 0
    moved = False

    if prefer_x and abs(dx) > 0:
        step = min(GOBLIN_SPEED, abs(dx))
        entity["x"] += step if dx > 0 else -step
        entity["dir_name"] = DIR_RIGHT if dx > 0 else DIR_LEFT
        moved = True
    elif (not prefer_x) and abs(dy) > 0:
        step = min(GOBLIN_SPEED, abs(dy))
        entity["y"] += step if dy > 0 else -step
        entity["dir_name"] = DIR_DOWN if dy > 0 else DIR_UP
        moved = True
    else:
        if abs(dx) > 0:
            step = min(GOBLIN_SPEED, abs(dx))
            entity["x"] += step if dx > 0 else -step
            entity["dir_name"] = DIR_RIGHT if dx > 0 else DIR_LEFT
            moved = True
        elif abs(dy) > 0:
            step = min(GOBLIN_SPEED, abs(dy))
            entity["y"] += step if dy > 0 else -step
            entity["dir_name"] = DIR_DOWN if dy > 0 else DIR_UP
            moved = True

    if moved and entity["axis_switch_timer"] >= GOBLIN_AXIS_SWITCH_MIN_TIME:
        entity["axis_toggle"] = 1 - entity["axis_toggle"]
        entity["axis_switch_timer"] = 0.0

    return False


def choose_roaming_target(entity):
    target_x = random.randrange(0, WIDTH - GOBLIN_SIZE + 1, GRID)
    target_y = random.randrange(0, HEIGHT - GOBLIN_SIZE + 1, GRID)

    entity["target_x"] = float(target_x)
    entity["target_y"] = float(target_y)

    dx = entity["target_x"] - entity["x"]
    dy = entity["target_y"] - entity["y"]

    if abs(dx) >= abs(dy):
        entity["dir_name"] = DIR_RIGHT if dx > 0 else DIR_LEFT
        entity["axis_toggle"] = 0
    else:
        entity["dir_name"] = DIR_DOWN if dy > 0 else DIR_UP
        entity["axis_toggle"] = 1

    entity["axis_switch_timer"] = 0.0


def choose_exit_target(entity):
    side = random.choice(["top", "bottom", "left", "right"])

    if side == "top":
        entity["target_x"] = float(random.randint(0, WIDTH - GOBLIN_SIZE))
        entity["target_y"] = float(-GOBLIN_SIZE - 10)
    elif side == "bottom":
        entity["target_x"] = float(random.randint(0, WIDTH - GOBLIN_SIZE))
        entity["target_y"] = float(HEIGHT + GOBLIN_SIZE + 10)
    elif side == "left":
        entity["target_x"] = float(-GOBLIN_SIZE - 10)
        entity["target_y"] = float(random.randint(0, HEIGHT - GOBLIN_SIZE))
    else:
        entity["target_x"] = float(WIDTH + GOBLIN_SIZE + 10)
        entity["target_y"] = float(random.randint(0, HEIGHT - GOBLIN_SIZE))

    entity["axis_switch_timer"] = 0.0


def update_goblin(entity, now, dt):
    if entity["state"] == "waiting":
        if now >= entity["cooldown_until"]:
            new_entity = spawn_goblin()
            new_entity["active_until"] = now + GOBLIN_ACTIVE_DURATION
            return new_entity
        return entity

    if entity["state"] == "entering":
        arrived = move_toward_point(entity, dt)
        if arrived:
            entity["state"] = "roaming"
            entity["turn_time"] = now + random.uniform(
                GOBLIN_TURN_INTERVAL_MIN, GOBLIN_TURN_INTERVAL_MAX
            )
            choose_roaming_target(entity)

    elif entity["state"] == "roaming":
        if now >= entity["active_until"]:
            entity["state"] = "leaving"
            choose_exit_target(entity)
        else:
            move_toward_point(entity, dt)
            if now >= entity["turn_time"]:
                choose_roaming_target(entity)
                entity["turn_time"] = now + random.uniform(
                    GOBLIN_TURN_INTERVAL_MIN, GOBLIN_TURN_INTERVAL_MAX
                )

    elif entity["state"] == "leaving":
        arrived = move_toward_point(entity, dt)

        outside = (
            entity["x"] + GOBLIN_SIZE < 0
            or entity["x"] > WIDTH
            or entity["y"] + GOBLIN_SIZE < 0
            or entity["y"] > HEIGHT
        )

        if arrived or outside:
            entity["state"] = "cooldown"
            entity["cooldown_until"] = now + GOBLIN_RESPAWN_DELAY

    elif entity["state"] == "cooldown":
        if now >= entity["cooldown_until"]:
            entity["state"] = "waiting"
            entity["cooldown_until"] = now + GOBLIN_FIRST_SPAWN_DELAY

    if entity["state"] in ("entering", "roaming", "leaving"):
        entity["anim_index"] += GOBLIN_ANIM_FPS * dt
    else:
        entity["anim_index"] = 0.0

    return entity


def draw_goblin(entity):
    if entity["state"] not in ("entering", "roaming", "leaving"):
        return

    rect = pygame.Rect(int(entity["x"]), int(entity["y"]), GOBLIN_SIZE, GOBLIN_SIZE)

    if goblin_frames is None:
        pygame.draw.rect(screen, YELLOW, rect)
        pygame.draw.rect(screen, BLACK, rect, 2)
        return

    frames = goblin_frames[entity["dir_name"]]
    frame = frames[int(entity["anim_index"]) % len(frames)]
    screen.blit(frame, rect.topleft)


def goblin_rect(entity):
    return pygame.Rect(int(entity["x"]), int(entity["y"]), GOBLIN_SIZE, GOBLIN_SIZE)


def run_game():
    global level
    level = level_select_screen()

    start_x = (WIDTH // 2 // MOVE_STEP) * MOVE_STEP
    start_y = (HEIGHT // 2 // MOVE_STEP) * MOVE_STEP

    snake = [(start_x, start_y)]
    direction = (MOVE_STEP, 0)
    next_direction = direction

    food = new_food(snake)
    score = 0
    speed = LEVELS[level]["speed"]
    move_delay = 1.0 / speed

    now = pygame.time.get_ticks() / 1000.0
    last_move_time = now
    last_frame_time = now

    trap_state = "inactive"
    trap_pos = None
    trap_start_time = 0.0
    next_trap_time = now + FIRST_TRAP_DELAY

    goblin = {
        "state": "waiting",
        "x": -9999.0,
        "y": -9999.0,
        "target_x": 0.0,
        "target_y": 0.0,
        "dir_name": DIR_DOWN,
        "anim_index": 0.0,
        "turn_time": 0.0,
        "active_until": 0.0,
        "cooldown_until": now + GOBLIN_FIRST_SPAWN_DELAY,
        "score_taken_lock": False,
        "axis_toggle": 0,
        "axis_switch_timer": 0.0,
    }

    while True:
        clock.tick(FPS)
        now = pygame.time.get_ticks() / 1000.0
        dt = now - last_frame_time
        last_frame_time = now

        for e in pygame.event.get():
            if e.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            if e.type == pygame.KEYDOWN:
                if e.key == pygame.K_UP and direction != (0, MOVE_STEP):
                    next_direction = (0, -MOVE_STEP)
                elif e.key == pygame.K_DOWN and direction != (0, -MOVE_STEP):
                    next_direction = (0, MOVE_STEP)
                elif e.key == pygame.K_LEFT and direction != (MOVE_STEP, 0):
                    next_direction = (-MOVE_STEP, 0)
                elif e.key == pygame.K_RIGHT and direction != (-MOVE_STEP, 0):
                    next_direction = (MOVE_STEP, 0)

        if trap_state == "inactive" and now >= next_trap_time:
            trap_pos = new_trap_position(snake, food)
            trap_state = "warning"
            trap_start_time = now
            warning_sound.stop()
            warning_sound.play()

        elif trap_state == "warning":
            elapsed = now - trap_start_time
            if warning_finished(elapsed):
                trap_state = "danger"
                trap_start_time = now

        elif trap_state == "danger":
            elapsed = now - trap_start_time
            if elapsed >= DANGER_TOTAL_DURATION:
                trap_state = "inactive"
                trap_pos = None
                next_trap_time = now + TRAP_RESPAWN_DELAY

        goblin = update_goblin(goblin, now, dt)

        if goblin["state"] in ("entering", "roaming", "leaving"):
            g_rect = goblin_rect(goblin)
            current_head_rect = pygame.Rect(
                snake[0][0], snake[0][1], BLOCK_SIZE, BLOCK_SIZE
            )

            if current_head_rect.colliderect(g_rect):
                if not goblin["score_taken_lock"]:
                    score = 0

                    trap_rect = None
                    if trap_pos is not None:
                        trap_rect = pygame.Rect(
                            trap_pos[0], trap_pos[1], TRAP_WIDTH, TRAP_HEIGHT
                        )

                    food = new_food(snake, trap_rect)
                    goblin["score_taken_lock"] = True
            else:
                goblin["score_taken_lock"] = False
        else:
            goblin["score_taken_lock"] = False

        if now - last_move_time >= move_delay:
            last_move_time += move_delay
            direction = next_direction

            head = (snake[0][0] + direction[0], snake[0][1] + direction[1])
            head_rect = pygame.Rect(head[0], head[1], BLOCK_SIZE, BLOCK_SIZE)

            if (
                head[0] < 0
                or head[0] + BLOCK_SIZE > WIDTH
                or head[1] < 0
                or head[1] + BLOCK_SIZE > HEIGHT
                or head in snake
            ):
                return score

            if trap_state == "danger" and trap_pos is not None:
                if rect_hits_danger_pattern(head_rect, trap_pos):
                    return score

            snake.insert(0, head)

            if head == food:
                score += 10

                trap_rect = None
                if trap_pos is not None:
                    trap_rect = pygame.Rect(
                        trap_pos[0], trap_pos[1], TRAP_WIDTH, TRAP_HEIGHT
                    )

                food = new_food(snake, trap_rect)

                if score % 50 == 0 and level < 3:
                    level = min(level + 1, 3)
                    speed = LEVELS[level]["speed"]
                    move_delay = 1.0 / speed
            else:
                snake.pop()

        screen.fill(GRAY)
        draw_grid()

        pygame.draw.rect(screen, RED, (food[0], food[1], BLOCK_SIZE, BLOCK_SIZE))
        draw_snake(snake)

        if trap_pos is not None:
            if trap_state == "warning":
                elapsed = now - trap_start_time
                if get_warning_visible(elapsed):
                    draw_pattern(WARNING_PATTERN, trap_pos, RED)

            elif trap_state == "danger":
                elapsed = now - trap_start_time
                if danger_active_image_is_red(elapsed):
                    draw_pattern(DANGER_PATTERN, trap_pos, RED)
                else:
                    draw_pattern(DANGER_PATTERN, trap_pos, YELLOW)

        draw_goblin(goblin)

        draw_hud(score, level)
        pygame.display.flip()


def main():
    while True:
        score = run_game()
        game_over_screen(score)


main()
